---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, publishDate, updatedDate, author, tags } = post.data;

const canonical = `https://www.zarivault.co.za/blog/${post.slug}`;
const fmt = (d: Date) => d.toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' });
const iso = (d: Date) => d.toISOString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: iso(publishDate),
    dateModified: iso(updatedDate ?? publishDate),
    author: { '@type': 'Organization', name: author, url: 'https://www.zarivault.co.za' },
    publisher: {
      '@type': 'Organization',
      name: 'Zari Vault',
      url: 'https://www.zarivault.co.za',
      logo: { '@type': 'ImageObject', url: 'https://www.zarivault.co.za/og-image.png' },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    image: 'https://www.zarivault.co.za/og-image.png',
    inLanguage: 'en-ZA',
    keywords: tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.zarivault.co.za/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.zarivault.co.za/blog' },
      { '@type': 'ListItem', position: 3, name: title, item: canonical },
    ],
  },
];
---
<BlogLayout title={`${title} | Zari Vault`} description={description} canonical={canonical} ogType="article" jsonLd={jsonLd}>
  <article>
    <div class="bl-article-head">
      <div class="bl-crumbs"><a href="/">Home</a> / <a href="/blog">Blog</a> / {title}</div>
      <h1>{title}</h1>
      <div class="bl-article-meta">
        By {author} · Published {fmt(publishDate)}{updatedDate && ` · Updated ${fmt(updatedDate)}`}
      </div>
    </div>

    <div class="bl-prose">
      <Content />

      <div class="bl-cta-box">
        <h3>Never get caught without your ID again</h3>
        <p>Zari Vault keeps your Smart ID, licence, passport and more encrypted on your phone, ready in 3 seconds. Free for your first 4 documents.</p>
        <a href="/#waitlist" class="btn-p">Download Free</a>
      </div>

      <p class="bl-disclaimer">This guide is general information, not legal or official advice. Government processes, fees and requirements change. Always confirm the latest details with the relevant South African authority (for example the Department of Home Affairs at dha.gov.za) before acting.</p>
    </div>

    <a class="bl-back" href="/blog">← Back to all guides</a>
  </article>
</BlogLayout>
