<!-- No analytics, tracking pixels or cookies are loaded on this site by design,
     in line with the POPIA notice and the app's zero-tracking promise. -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does Zari Vault work without internet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, completely. All documents are stored locally on your device using AES-256 encryption. Zari Vault never needs an internet connection to access your documents."
      }
    },
    {
      "@type": "Question",
      "name": "What happens to my documents if I lose my phone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your documents are stored only on your device. If you lose your phone, your data is protected by biometric lock and AES-256 encryption. You can restore from an encrypted backup to a new device."
      }
    },
    {
      "@type": "Question",
      "name": "Is a digital copy legally accepted in South Africa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For most everyday purposes, yes. Many institutions accept verified digital copies. Zari Vault's personal copies are watermarked and timestamped. Some formal legal proceedings still require originals."
      }
    },
    {
      "@type": "Question",
      "name": "Can Zari Vault see my documents?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Zari Vault has zero access to your documents. Everything is encrypted on your device using a key derived from your biometric. Our servers never receive your document data."
      }
    },
    {
      "@type": "Question",
      "name": "How is Zari Vault different from taking a photo on my phone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Photos on your phone are unencrypted, visible in your camera roll, backed up to cloud services, and can be accessed by any app with photo permissions. Zari Vault encrypts everything with AES-256, requires biometric authentication, and never leaves your device."
      }
    },
    {
      "@type": "Question",
      "name": "What is the auto-lock timer and why does it matter?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The auto-lock timer automatically locks the vault after a set period of inactivity. When locked, all document data is re-encrypted and removed from memory, protecting you if someone picks up your unlocked phone."
      }
    },
    {
      "@type": "Question",
      "name": "How does the free plan differ from Premium?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The free plan includes up to 4 documents with full biometric lock and AES-256 encryption. Premium at R249.99 per year (less than R21 per month) unlocks storage for up to 10 documents, document expiry alerts, custom nicknames, pinch-to-zoom, configurable auto-lock, and biometric-verified clipboard copy."
      }
    },
    {
      "@type": "Question",
      "name": "Is Zari Vault POPIA compliant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Zari Vault is designed from the ground up to comply with South Africa's Protection of Personal Information Act. We collect zero personal data on our servers, use no analytics cookies, and give you complete control over your information."
      }
    },
    {
      "@type": "Question",
      "name": "Which countries and document types are supported?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zari Vault supports documents from 149 countries including South African Smart ID cards, driver's licences, passports, medical aid cards, vehicle registration, and more. New document types are added regularly."
      }
    }
  ]
}
</script>
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<script type="application/ld+json" is:inline>
{
