<script is:inline>
/* ===== Submissions =====
   Every contact / waitlist / exit-popup / download form posts JSON to /api/submit,
   a Vercel serverless function that stores the record in Supabase (RLS-locked) and
   emails a notification via Resend. No API keys or database access exist in the
   browser; the client only ever talks to our own /api/submit endpoint. */
function postSubmission(data){
  return fetch('/api/submit',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(data)
  }).then(function(r){return r.json().catch(function(){return {success:r.ok};});});
}

/* ---- Progress bar ---- */
function updateProgress(){
  const s=document.documentElement,h=s.scrollHeight-s.clientHeight;
  document.getElementById('progress-bar').style.setProperty('--progress-w',(window.scrollY/h*100)+'%');
  document.getElementById('progress-bar').style.width=(window.scrollY/h*100)+'%';
}
window.addEventListener('scroll',updateProgress,{passive:true});

/* ---- Scroll-to-top ---- */
const scrollBtn=document.getElementById('scroll-top');
function checkScrollBtn(){scrollBtn.classList.toggle('show',window.scrollY>400);}
window.addEventListener('scroll',checkScrollBtn,{passive:true});

/* ---- Hamburger ---- */
const ham=document.getElementById('ham'),nmob=document.getElementById('nmob');
ham.addEventListener('click',()=>{ham.classList.toggle('open');nmob.classList.toggle('open');});
nmob.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{ham.classList.remove('open');nmob.classList.remove('open');}));

/* ---- Dark mode ---- */
const themeBtn=document.getElementById('theme-toggle');
function setTheme(t){
  document.documentElement.setAttribute('data-theme',t);
  localStorage.setItem('zv-theme',t);
  themeBtn.textContent=t==='dark'?'☀️':'🌙';
}
const saved=localStorage.getItem('zv-theme')||'light';
setTheme(saved);
themeBtn.addEventListener('click',()=>{
  setTheme(document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark');
});

/* ---- Navbar scroll + active nav ---- */
const navbar=document.getElementById('navbar');
const navAs=document.querySelectorAll('.nav-links a:not(.nav-cta)');
const secs=document.querySelectorAll('section[id],div[id]');
function onScroll(){
  navbar.classList.toggle('scrolled',window.scrollY>20);
  let cur='';
  secs.forEach(s=>{if(window.scrollY>=s.offsetTop-120)cur=s.id;});
  navAs.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+cur));
}
window.addEventListener('scroll',onScroll,{passive:true});
onScroll();

/* ---- Reveal on scroll ---- */
const revEls=document.querySelectorAll('.rev,.rev-l,.rev-r');
const ro=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('vis');});},{threshold:0.1});
revEls.forEach(el=>ro.observe(el));

/* ---- Animated stat counters ---- */
function animateCounter(el){
  const target=parseInt(el.dataset.count);
  const suffix=el.dataset.suffix||'';
  if(target===0){el.textContent='0'+suffix;return;}
  let start=0,duration=1800,startTime=null;
  function step(ts){
    if(!startTime)startTime=ts;
    const progress=Math.min((ts-startTime)/duration,1);
    const ease=1-Math.pow(1-progress,3);
    el.textContent=Math.round(ease*target)+suffix;
    if(progress<1)requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
const statsObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.querySelectorAll('[data-count]').forEach(animateCounter);
      statsObs.unobserve(e.target);
    }
  });
},{threshold:0.5});
const statsEl=document.getElementById('stats');
if(statsEl)statsObs.observe(statsEl);

/* ---- Phone carousel ---- */
let cur=0,asi;
function gotoScr(n){
  document.getElementById('sc'+cur).classList.remove('on');
  document.querySelectorAll('.s-dot')[cur].classList.remove('on');
  cur=n;
  document.getElementById('sc'+cur).classList.add('on');
  document.querySelectorAll('.s-dot')[cur].classList.add('on');
  clearInterval(asi);
  asi=setInterval(()=>gotoScr((cur+1)%3),3400);
}
asi=setInterval(()=>gotoScr((cur+1)%3),3400);

/* ---- Document showcase ---- */
function showDoc(id,tile){
  document.querySelectorAll('.doc-tile').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.doc-preview').forEach(p=>p.classList.remove('active'));
  tile.classList.add('active');
  const prev=document.getElementById('doc-preview-'+id);
  if(prev)prev.classList.add('active');
}

/* ---- FAQ accordion ---- */
function toggleFaq(btn){
  const item=btn.closest('.faq-item');
  const isOpen=item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));
  if(!isOpen)item.classList.add('open');
}

/* ---- Contact form ---- */
function submitForm(){
  if(!document.getElementById('fn').value.trim()||!document.getElementById('em').value.trim()||!document.getElementById('msg').value.trim()){alert('Please fill in your name, email and message.');return;}
  document.getElementById('ff').style.display='none';
  document.getElementById('fok').style.display='block';
}

/* ---- POPIA banner ---- */
function dismissBanner(){
  const b=document.getElementById('popia-banner');
  b.classList.remove('show');
  sessionStorage.setItem('zv-banner','dismissed');
}
window.addEventListener('load',()=>{
  if(!sessionStorage.getItem('zv-banner')){
    setTimeout(()=>document.getElementById('popia-banner').classList.add('show'),1500);
  }
});

/* ---- Waitlist signup ---- */
function joinWaitlist(){
  var email=document.getElementById('wl-email').value.trim();
  if(!email||email.indexOf('@')<0){document.getElementById('wl-email').style.borderColor='#ef4444';document.getElementById('wl-email').focus();return;}
  postSubmission({type:'waitlist',email:email,source:'waitlist section'});
  document.getElementById('wl-form').style.display='none';
  document.getElementById('wl-ok').style.display='block';
  var ep=document.getElementById('ep-email');if(ep)ep.value=email;
}
/* ---- Exit intent ---- */
var exitShown=false;
function showExitPopup(){if(exitShown||sessionStorage.getItem('zv-exit'))return;exitShown=true;document.getElementById('exit-popup').style.display='flex';document.body.style.overflow='hidden';}
function closeExitPopup(){document.getElementById('exit-popup').style.display='none';document.body.style.overflow='';sessionStorage.setItem('zv-exit','1');}
function submitExitPopup(){
  var email=document.getElementById('ep-email').value.trim();
  if(!email||email.indexOf('@')<0){document.getElementById('ep-email').style.borderColor='#ef4444';document.getElementById('ep-email').focus();return;}
  postSubmission({type:'exit',email:email,source:'exit popup'});
  setTimeout(closeExitPopup,3000);
  document.getElementById('exit-popup').querySelector('h3').textContent='You are on the list!';
}
document.addEventListener('mouseleave',function(e){if(e.clientY<=0)showExitPopup();});
/* ---- Contact submit ---- */
function handleContactSubmit(e){
  e.preventDefault();
  var form=document.getElementById('ff');
  var btn=form.querySelector('[type="submit"]');
  var hp=document.getElementById('botcheck');
  var payload={
    type:'contact',
    firstName:document.getElementById('fn').value.trim(),
    lastName:document.getElementById('ln').value.trim(),
    email:document.getElementById('em').value.trim(),
    subject:document.getElementById('sb2').value,
    message:document.getElementById('msg').value.trim(),
    source:'contact form',
    botcheck:hp&&hp.checked
  };
  btn.textContent='Sending…';btn.disabled=true;
  postSubmission(payload)
    .then(function(d){
      if(d&&d.success){form.style.display='none';document.getElementById('fok').style.display='block';}
      else{btn.textContent='Send Message →';btn.disabled=false;alert('Something went wrong. Please email hello@zarivault.co.za');}
    })
    .catch(function(){btn.textContent='Send Message →';btn.disabled=false;alert('Network error. Please email hello@zarivault.co.za');});
}
</script>

